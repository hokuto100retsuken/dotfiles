[core]
  editor = nvim
  autocrlf = false
  quotepath = false
  pager = delta
[color]
  ui = true
[ghq]
  root = ~/src
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[alias]
  aliases = "!git config --get-regexp ^alias\\. | sed 's/^alias\\.//; s/ /\t= /' | sort"
  s = status -sb
  d = diff
  dc = diff --cached
  l = log --oneline --graph -20
  la = log --oneline --graph --all -20
  co = checkout
  sw = switch
  swc = switch -c
  unstage = reset HEAD --
  amend = commit --amend --no-edit
  wip = "!git add -A && git commit -m 'wip'"
  pushf = push --force-with-lease
  dft = difftool -t difftastic
  dftc = difftool -t difftastic --staged
  delete-merged-branch = "!f () { git checkout $1; git branch --format='%(refname:short) %(worktreepath)' --merged | awk 'NF == 1' | grep -Ev '^(develop|main|master)$' | xargs -r git branch -d; };f"
  branch-date = "!f() { git checkout -b $(git config user.name)-$(date +'%Y%m%d%H%M%S'); }; f"
[interactive]
  diffFilter = delta --color-only --features=interactive

# difftastic（構文単位の差分）。`git diff` は従来どおり delta のままにして、
# `git dft` / `git dftc` のときだけ difft を使う。
# delta は行単位の色付け、difft は構文の対応付けが得意なので用途が違う。
# pager.difftool に less を明示しているのは、core.pager=delta を通すと
# difft の出力を delta が再解析して壊すため。
[diff]
  tool = difftastic
[difftool]
  prompt = false
[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"
[pager]
  difftool = less -RFX
[delta]
  features = decorations
[delta "interactive"]
  keep-plus-minus-markers = false
[delta "decorations"]
  commit-decoration-style = blue ol
  commit-style = raw
  file-style = omit
  hunk-header-decoration-style = blue box
  hunk-header-file-style = red
  hunk-header-line-number-style = "#067a00"
  hunk-header-style = file line-number syntax
[user]
  email = hokuto100retsuken@gmail.com
  name = hkt100rtkn
[includeIf "gitdir:~/src/github.com/"]
  path = ~/src/github.com/.gitconfig

[core]
    excludesfile = ~/.gitignore_global

# 環境固有の設定（存在しなければ無視される）
[include]
  path = ~/.gitconfig.local
